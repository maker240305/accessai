{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "node"],
    "resolveJsonModule": true
  },
  "include": [
    "extension/**/*.ts",
    "extension/**/*.tsx",
    "shared/**/*.ts",
    "proxy/**/*.ts",
    "tests/**/*.ts"
  ]
}
