{
  "name": "accessai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd extension && wxt",
    "build": "cd extension && wxt build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "pnpm build && node scripts/package.mjs",
    "proxy:dev": "wrangler dev --config proxy/wrangler.toml",
    "proxy:deploy": "wrangler deploy --config proxy/wrangler.toml"
  },
  "dependencies": {
    "axe-core": "^4.10.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "eslint": "^9.0.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.50.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0",
    "wxt": "^0.20.0"
  }
}
